{
  "id": "/reminders-app",
  "name": "یادآورها | Customs OS",
  "short_name": "یادآورها",
  "description": "اپ مستقل یادآورهای عملیاتی با اعلان، تاریخ شمسی و اتصال مستقیم به محموله‌ها و پرونده‌ها",
  "start_url": "/reminders?app=1",
  "scope": "/reminders",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "dir": "rtl",
  "lang": "fa",
  "theme_color": "#06265F",
  "background_color": "#F3F7FC",
  "icons": [
    {
      "src": "/pwa/reminders-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/pwa/reminders-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "یادآور جدید",
      "short_name": "یادآور جدید",
      "url": "/reminders?new=1",
      "icons": [
        {
          "src": "/pwa/reminders-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "یادآورهای امروز",
      "short_name": "امروز",
      "url": "/reminders?view=today",
      "icons": [
        {
          "src": "/pwa/reminders-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "کارهای انجام‌شده",
      "short_name": "انجام‌شده",
      "url": "/reminders?view=done",
      "icons": [
        {
          "src": "/pwa/reminders-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
