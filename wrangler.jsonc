{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "customs",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "vars": {
    "SUPABASE_URL": "https://bjngfgiecvihofemptub.supabase.co"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/edge/*", "/api/webrtc/*", "/chat", "/chat/*"],
    "html_handling": "none",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "darbandicommercial.ir",
      "custom_domain": true
    },
    {
      "pattern": "chat.darbandicommercial.ir",
      "custom_domain": true
    }
  ]
}
