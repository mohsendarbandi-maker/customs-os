{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "customs",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "vars": {
    "SUPABASE_URL": "https://bjngfgiecvihofemptub.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_pIh0yF6SQcQ-IAa_FkbjWA_qTSm83Sr"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/assets/*",
      "/api/edge/*",
      "/api/webrtc/*",
      "/chat",
      "/chat/*",
      "/api/messenger/*",
      "/webhooks/messenger/*"
    ],
    "html_handling": "none",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "darbandicommercial.ir",
      "custom_domain": true
    },
    {
      "pattern": "chat.darbandicommercial.ir",
      "custom_domain": true
    },
    {
      "pattern": "reminders.darbandicommercial.ir",
      "custom_domain": true
    }
  ]
}
