{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "customs-os-migration-preview",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SUPABASE_URL": "https://bjngfgiecvihofemptub.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_pIh0yF6SQcQ-IAa_FkbjWA_qTSm83Sr"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/__auth-bridge.html",
      "/assets/*",
      "/auth/*",
      "/rest/*",
      "/storage/*",
      "/realtime/*",
      "/functions/*",
      "/graphql/*",
      "/api/*",
      "/chat",
      "/chat/*",
      "/manifest.webmanifest",
      "/chat-app-v3.webmanifest",
      "/chat-app-v4.webmanifest",
      "/chat-manifest.webmanifest",
      "/chat-subdomain.webmanifest",
      "/manifest-chat.webmanifest",
      "/manifest-reminders.webmanifest",
      "/reminders-subdomain.webmanifest",
      "/mobile-subdomain.webmanifest",
      "/webhooks/messenger/*"
    ],
    "html_handling": "none",
    "not_found_handling": "single-page-application"
  }
}
